{
  "name": "one-light",
  "type": "light",
  "colors": {
    "editor.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editor.selectionBackground": "#e5e5e6",
    "focusBorder": "#0184bc",
    "statusBar.background": "#dbdbdc",
    "statusBar.foreground": "#090a0b",
    "terminal.background": "#fafafa",
    "terminal.foreground": "#383a42",
    "terminalCursor.foreground": "#4078f2",
    "terminal.ansiBlack": "#fafafa",
    "terminal.ansiRed": "#e45649",
    "terminal.ansiGreen": "#50a14f",
    "terminal.ansiYellow": "#c18401",
    "terminal.ansiBlue": "#4078f2",
    "terminal.ansiMagenta": "#a626a4",
    "terminal.ansiCyan": "#0184bc",
    "terminal.ansiWhite": "#383a42",
    "terminal.ansiBrightBlack": "#a0a1a7",
    "terminal.ansiBrightRed": "#e45649",
    "terminal.ansiBrightGreen": "#50a14f",
    "terminal.ansiBrightYellow": "#c18401",
    "terminal.ansiBrightBlue": "#4078f2",
    "terminal.ansiBrightMagenta": "#a626a4",
    "terminal.ansiBrightCyan": "#0184bc",
    "terminal.ansiBrightWhite": "#090a0b"
  },
  "tokenColors": [
    { "scope": "comment", "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
    { "scope": "comment.block.documentation", "settings": { "foreground": "#383a42", "fontStyle": "italic" } },
    { "scope": "string", "settings": { "foreground": "#50a14f" } },
    { "scope": "constant", "settings": { "foreground": "#a626a4" } },
    { "scope": "constant.character.escape", "settings": { "foreground": "#50a14f", "fontStyle": "bold" } },
    { "scope": "keyword", "settings": { "foreground": "#4078f2", "fontStyle": "bold" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#0184bc" } },
    { "scope": "entity.name.function", "settings": { "foreground": "#c18401" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#0184bc" } },
    { "scope": "punctuation", "settings": { "foreground": "#383a42" } },
    { "scope": "variable", "settings": { "foreground": "#090a0b" } },
    { "scope": "variable.other.member", "settings": { "foreground": "#4078f2" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#a626a4" } },
    { "scope": "markup.heading", "settings": { "foreground": "#0184bc", "fontStyle": "bold" } },
    { "scope": "markup.underline.link", "settings": { "foreground": "#4078f2", "fontStyle": "underline" } }
  ]
}
